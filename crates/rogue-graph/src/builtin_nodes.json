 {
  "type": "flow.for_radius",
  "kind": "flow",
  "title": "For Each In Radius",
  "category": "Flow",
  "inputs": [
   {
    "name": "exec",
    "ty": "exec"
   },
   {
    "name": "x",
    "ty": "number",
    "default": 0
   },
   {
    "name": "y",
    "ty": "number",
    "default": 0
   },
   {
    "name": "radius",
    "ty": "number",
    "default": 3
   }
  ],
  "outputs": [
   {
    "name": "body",
    "ty": "exec"
   },
   {
    "name": "entity",
    "ty": "entity",
    "expr": "__loop_entity"
   },
   {
    "name": "then",
    "ty": "exec"
   }
  ],
  "template": "for _, __loop_entity in ipairs(rogue.in_radius(${x}, ${y}, ${radius})) do\n${body}\nend\n${then}"
 },
