   {
    "name": "then",
    "ty": "exec"
   },
   {
    "name": "entity",
    "ty": "entity",
    "expr": "ev.id"
   },
   {
    "name": "killer",
    "ty": "entity",
    "expr": "ev.killer"
   },
   {
    "name": "kind",
    "ty": "string",
    "expr": "ev.kind"
   },
   {
    "name": "x",
    "ty": "number",
