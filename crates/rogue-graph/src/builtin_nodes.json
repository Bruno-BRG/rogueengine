  "type": "flow.branch",
  "kind": "flow",
  "title": "Branch",
  "category": "Flow",
  "inputs": [
   {
    "name": "exec",
    "ty": "exec"
   },
   {
    "name": "condition",
    "ty": "bool",
    "default": false
   }
  ],
  "outputs": [
   {
    "name": "true",
    "ty": "exec"
   },
   {
    "name": "false",
    "ty": "exec"
   }
  ],
  "template": "if ${condition} then\n${true}\nelse\n${false}\nend"
 },
 {
  "type": "flow.sequence",
