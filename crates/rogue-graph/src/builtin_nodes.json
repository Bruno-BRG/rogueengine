[
  {"type":"event.died","kind":"event","title":"On Died","category":"Events",
   "outputs":[{"name":"then","ty":"exec"},{"name":"entity","ty":"entity","expr":"ev.id"},{"name":"killer","ty":"entity","expr":"ev.killer"}],
   "template":"rogue.on(\"died\", function(ev)\n${then}\nend)"},
  {"type":"event.attacked","kind":"event","title":"On Attacked","category":"Events",
   "outputs":[{"name":"then","ty":"exec"},{"name":"attacker","ty":"entity","expr":"ev.attacker"},{"name":"target","ty":"entity","expr":"ev.target"},{"name":"damage","ty":"number","expr":"ev.damage"}],
   "template":"rogue.on(\"attacked\", function(ev)\n${then}\nend)"},
  {"type":"event.moved","kind":"event","title":"On Moved","category":"Events",
   "outputs":[{"name":"then","ty":"exec"},{"name":"entity","ty":"entity","expr":"ev.id"},{"name":"x","ty":"number","expr":"ev.to.x"},{"name":"y","ty":"number","expr":"ev.to.y"}],
   "template":"rogue.on(\"moved\", function(ev)\n${then}\nend)"},
  {"type":"event.turn_started","kind":"event","title":"On Turn Started","category":"Events",
   "outputs":[{"name":"then","ty":"exec"},{"name":"entity","ty":"entity","expr":"ev.id"}],
   "template":"rogue.on(\"turn_started\", function(ev)\n${then}\nend)"},
  {"type":"event.item_picked","kind":"event","title":"On Item Picked Up","category":"Events",
   "outputs":[{"name":"then","ty":"exec"},{"name":"who","ty":"entity","expr":"ev.who"},{"name":"item","ty":"entity","expr":"ev.item"}],
   "template":"rogue.on(\"item_picked\", function(ev)\n${then}\nend)"},

  {"type":"flow.branch","kind":"flow","title":"Branch","category":"Flow",
   "inputs":[{"name":"exec","ty":"exec"},{"name":"condition","ty":"bool","default":false}],
   "outputs":[{"name":"true","ty":"exec"},{"name":"false","ty":"exec"}],
   "template":"if ${condition} then\n${true}\nelse\n${false}\nend"},
  {"type":"flow.sequence","kind":"flow","title":"Sequence","category":"Flow",
   "inputs":[{"name":"exec","ty":"exec"}],
   "outputs":[{"name":"a","ty":"exec"},{"name":"b","ty":"exec"}],
   "template":"${a}\n${b}"},
  {"type":"flow.if_exists","kind":"flow","title":"If Entity Exists","category":"Flow",
   "inputs":[{"name":"exec","ty":"exec"},{"name":"entity","ty":"entity"}],
   "outputs":[{"name":"then","ty":"exec"}],
   "template":"if ${entity} ~= nil and rogue.exists(${entity}) then\n${then}\nend"},

  {"type":"action.log","kind":"flow","title":"Log Message","category":"Actions",
   "inputs":[{"name":"exec","ty":"exec"},{"name":"text","ty":"string","default":"Hello"}],
   "outputs":[{"name":"then","ty":"exec"}],
   "template":"rogue.log(${text})\n${then}"},
  {"type":"action.damage","kind":"flow","title":"Deal Damage","category":"Actions",
   "inputs":[{"name":"exec","ty":"exec"},{"name":"source","ty":"entity"},{"name":"target","ty":"entity"},{"name":"amount","ty":"number","default":1}],
   "outputs":[{"name":"then","ty":"exec"}],
   "template":"rogue.damage(${source}, ${target}, ${amount})\n${then}"},
  {"type":"action.heal","kind":"flow","title":"Heal","category":"Actions",
   "inputs":[{"name":"exec","ty":"exec"},{"name":"target","ty":"entity"},{"name":"amount","ty":"number","default":5}],
   "outputs":[{"name":"then","ty":"exec"}],
   "template":"rogue.heal(${target}, ${amount})\n${then}"},
  {"type":"action.spawn","kind":"flow","title":"Spawn Entity","category":"Actions",
   "inputs":[{"name":"exec","ty":"exec"},{"name":"def","ty":"string","default":"goblin"},{"name":"x","ty":"number","default":0},{"name":"y","ty":"number","default":0}],
   "outputs":[{"name":"then","ty":"exec"}],
   "template":"rogue.spawn(${def}, ${x}, ${y})\n${then}"},
  {"type":"action.set_data","kind":"flow","title":"Set Data","category":"Actions",
   "inputs":[{"name":"exec","ty":"exec"},{"name":"entity","ty":"entity"},{"name":"key","ty":"string","default":"key"},{"name":"value","ty":"any"}],
   "outputs":[{"name":"then","ty":"exec"}],
   "template":"rogue.set_data(${entity}, ${key}, ${value})\n${then}"},
  {"type":"action.add_tag","kind":"flow","title":"Add Tag","category":"Actions",
   "inputs":[{"name":"exec","ty":"exec"},{"name":"entity","ty":"entity"},{"name":"tag","ty":"string","default":"tag"}],
   "outputs":[{"name":"then","ty":"exec"}],
   "template":"rogue.add_tag(${entity}, ${tag})\n${then}"},

  {"type":"data.number","kind":"data","title":"Number","category":"Values",
   "inputs":[{"name":"value","ty":"number","default":0}],"outputs":[{"name":"out","ty":"number"}],"template":"${value}"},
  {"type":"data.string","kind":"data","title":"Text","category":"Values",
   "inputs":[{"name":"value","ty":"string","default":""}],"outputs":[{"name":"out","ty":"string"}],"template":"${value}"},
  {"type":"data.bool","kind":"data","title":"Boolean","category":"Values",
   "inputs":[{"name":"value","ty":"bool","default":true}],"outputs":[{"name":"out","ty":"bool"}],"template":"${value}"},
  {"type":"math.add","kind":"data","title":"Add","category":"Math",
   "inputs":[{"name":"a","ty":"number","default":0},{"name":"b","ty":"number","default":0}],"outputs":[{"name":"out","ty":"number"}],"template":"${a} + ${b}"},
  {"type":"math.sub","kind":"data","title":"Subtract","category":"Math",
   "inputs":[{"name":"a","ty":"number","default":0},{"name":"b","ty":"number","default":0}],"outputs":[{"name":"out","ty":"number"}],"template":"${a} - ${b}"},
  {"type":"math.mul","kind":"data","title":"Multiply","category":"Math",
   "inputs":[{"name":"a","ty":"number","default":1},{"name":"b","ty":"number","default":1}],"outputs":[{"name":"out","ty":"number"}],"template":"${a} * ${b}"},
  {"type":"math.random","kind":"data","title":"Random Int","category":"Math",
   "inputs":[{"name":"min","ty":"number","default":1},{"name":"max","ty":"number","default":6}],"outputs":[{"name":"out","ty":"number"}],"template":"rogue.random(${min}, ${max})"},
  {"type":"logic.greater","kind":"data","title":"Greater Than","category":"Logic",
   "inputs":[{"name":"a","ty":"number","default":0},{"name":"b","ty":"number","default":0}],"outputs":[{"name":"out","ty":"bool"}],"template":"${a} > ${b}"},
  {"type":"logic.equal","kind":"data","title":"Equal","category":"Logic",
   "inputs":[{"name":"a","ty":"any"},{"name":"b","ty":"any"}],"outputs":[{"name":"out","ty":"bool"}],"template":"${a} == ${b}"},
  {"type":"logic.and","kind":"data","title":"And","category":"Logic",
   "inputs":[{"name":"a","ty":"bool","default":true},{"name":"b","ty":"bool","default":true}],"outputs":[{"name":"out","ty":"bool"}],"template":"${a} and ${b}"},
  {"type":"logic.not","kind":"data","title":"Not","category":"Logic",
   "inputs":[{"name":"a","ty":"bool","default":false}],"outputs":[{"name":"out","ty":"bool"}],"template":"not ${a}"},
  {"type":"logic.chance","kind":"data","title":"Chance","category":"Logic",
   "inputs":[{"name":"p","ty":"number","default":0.5}],"outputs":[{"name":"out","ty":"bool"}],"template":"rogue.chance(${p})"},
  {"type":"entity.stat","kind":"data","title":"Get Stat","category":"Entity",
   "inputs":[{"name":"entity","ty":"entity"},{"name":"stat","ty":"string","default":"hp"}],"outputs":[{"name":"out","ty":"number"}],"template":"rogue.stat(${entity}, ${stat})"},
  {"type":"entity.get_data","kind":"data","title":"Get Data","category":"Entity",
   "inputs":[{"name":"entity","ty":"entity"},{"name":"key","ty":"string","default":"key"}],"outputs":[{"name":"out","ty":"any"}],"template":"rogue.get_data(${entity}, ${key})"},
  {"type":"entity.has_tag","kind":"data","title":"Has Tag","category":"Entity",
   "inputs":[{"name":"entity","ty":"entity"},{"name":"tag","ty":"string","default":"tag"}],"outputs":[{"name":"out","ty":"bool"}],"template":"rogue.has_tag(${entity}, ${tag})"}
]
